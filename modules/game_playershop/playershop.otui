ShopTableRow < TableRow
  height: 18
  padding: 2 0 2 0
  margin-bottom: 2

ShopItemBox < Panel
  UICheckBox
    id: itemBox
    anchors.fill: parent
    border-width: 1
    color: #aaaaaa
    text-align: bottom
    text-offset: 0 -4
    @onCheckChange: GamePlayerShop.onItemBoxChecked(self)

    Item
      id: item
      phantom: true
      anchors.top: parent.top
      margin-top: 5
      anchors.horizontalCenter: parent.horizontalCenter
      image-color: #ffffffff

      $!on:
        image-color: #ffffff88

    $checked on:
      border-color: #faebd5

    $!checked:
      border-color: #7b6e4c

    $!on:
      border-color: #7b6e4c88
      image-color: #ffffff88
      color: #aaaaaa88

  CloseMenuButton
    id: removeItemButton
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 5
    margin-right: 5

  InfoMenuButton
    anchors.top: parent.top
    anchors.right: prev.right
    anchors.verticalCenter: none
    margin-top: 5
    margin-right: 5


MainWindow
  id: ShopWindow
  &loc: '${GamePlayerShopWindowTitle}'
  size: 600 620
  @onEscape: GamePlayerShop.closeShop()

  Button
    &loc: '${CorelibInfoClose}'
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    @onClick: GamePlayerShop.closeShop()

  Button
    id: tradeButton
    &loc: '${GamePlayerShopButtonTrade}'
    anchors.right: prev.left
    anchors.bottom: parent.bottom
    margin-right: 10
    @onClick: GamePlayerShop.onTradeClick()

  LightFlatPanel
    id: buyOptions
    width: 200
    height: 144
    anchors.bottom: prev.top
    anchors.right: parent.right
    margin-bottom: 10

    Label
      id: searchLabel
      &loc: '${GamePlayerShopSearchLabel}:'
      anchors.left: parent.left
      anchors.top: parent.top
      text-auto-resize: true
      margin-top: 7
      margin-left: 5

    TextEdit
      id: searchText
      anchors.top: prev.top
      anchors.left: prev.right
      anchors.right: parent.right
      margin-top: -2
      margin-left: 5
      margin-right: 5
      @onTextChange: GamePlayerShop.refreshPlayerGoods()

    Panel
      id: buyOptionsContainer
      anchors.top: searchText.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 5
      margin-left: 5
      margin-right: 5
      layout: verticalBox

      CheckBox
        id: bankTrade
        &loc: '${GamePlayerShopBankTrade}'
        margin-top: 0
        @onCheckChange: GamePlayerShop.refreshPlayerGoods()

      CheckBox
        id: buyWithBackpack
        &loc: '${GamePlayerShopBuyWithBackpack}'
        margin-top: 2
        @onCheckChange: GamePlayerShop.refreshSelectedItem()

      CheckBox
        id: ignoreCapacity
        &loc: '${GamePlayerShopIgnoreCapacity}'
        margin-top: 2
        @onCheckChange: GamePlayerShop.refreshPlayerGoods()

      CheckBox
        id: showAllItems
        &loc: '${GamePlayerShopShowAllItems}'
        margin-top: 2
        visible: false
        checked: true
        @onCheckChange: GamePlayerShop.refreshPlayerGoods()

  LightFlatPanel
    id: setupPanel
    enabled: false
    anchors.top: prev.top
    anchors.bottom: prev.bottom
    anchors.left: parent.left
    anchors.right: prev.outsideLeft
    margin-right: 5

    Table
      id: setupTable
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: quantityScroll.top
      margin-bottom: 5
      table-data: setupData
      row-style: ShopTableRow

    TableData
      id: setupData
      anchors.fill: parent

    HorizontalScrollBar
      id: quantityScroll
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-bottom: 5
      margin-left: 5
      margin-right: 5
      show-value: true
      minimum: 1
      maximum: 100
      step: 1
      @onValueChange: GamePlayerShop.refreshSelectedItem()

  LightFlatPanel
    id: itemsArea
    anchors.top: parent.top
    anchors.bottom: setupPanel.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-bottom: 6
    padding-top: 4
    padding-left: 4
    padding-bottom: 4
    padding-right: 4

    VerticalScrollBar
      id: itemsPanelListScrollBar
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      step: 24
      pixels-scroll: true

    ScrollablePanel
      id: itemsPanel
      height: 250
      anchors.left: parent.left
      anchors.right: prev.left
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      vertical-scrollbar: itemsPanelListScrollBar
      margin-left: 1
      margin-right: 4
      phantom: false
      layout:
        type: grid
        cell-size: 180 114
        flow: true
        auto-spacing: true


PriceWindow < MainWindow
  id: priceWindow
  &loc: '${GameInterfaceCountWindowTitle}'
  size: 196 90

  Item
    id: item
    anchors.left: parent.left
    anchors.top: parent.top
    margin-top: 2
    margin-left: 2
    focusable: false
    virtual: true

  TextEdit
    id: itemValue
    anchors.top: prev.top
    anchors.left: prev.right
    anchors.right: parent.right
    margin-top: 5
    margin-left: 5
    margin-right: 5

  Button
    id: buttonOk
    &loc: '${CorelibInfoOk}'
    height: 20
    width: 30
    anchors.right: parent.right
    anchors.top: itemValue.bottom
    margin-bottom: 2
    margin-right: 2
    focusable: false

  Button
    id: buttonCancel
    &loc: '${CorelibInfoCancel}'
    height: 20
    anchors.right: prev.left
    anchors.left: parent.horizontalCenter
    anchors.top: itemValue.bottom
    margin-bottom: 2
    focusable: false


